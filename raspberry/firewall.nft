# DEVELOPED BY CARROTSTUDIO software house
# Firewall for the hotspot interface only (@IFACE@ is filled in by install.sh).
# Phones get DHCP, DNS and Campanile (80, 8081): nothing else on the Raspberry, and no way
# through it into any other network it is connected to.
table inet campanile
delete table inet campanile
table inet campanile {
    chain input {
        type filter hook input priority 0; policy accept;
        iifname "@IFACE@" jump from_phones
    }

    # Open connections per phone, by MAC address, which a phone can't change without leaving
    # the network. A browser needs a dozen; 64 leaves room for tabs, or a repeater showing a few
    # phones as one. Otherwise one device holding thousands of silent connections fills nginx
    # for everyone (measured: 27 phone requests in 60 failed, 1.7 MB of nginx log a minute).
    set connections_per_phone {
        type ether_addr
        flags dynamic
    }

    chain from_phones {
        ct state established,related accept
        meta l4proto icmp accept
        udp dport { 53, 67 } accept
        tcp dport { 80, 8081 } ct state new add @connections_per_phone { ether saddr ct count over 64 } reject with tcp reset
        tcp dport { 53, 80, 8081 } accept
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy accept;
        iifname "@IFACE@" drop
    }
}
